{
  "name": "@local/dsh-mistral-usage",
  "version": "0.1.0",
  "private": true,
  "description": "Mistral API usage for DeepSeek Harness: a sidebar card and a Settings page showing the plan and monthly allowance Mistral's billing API reports, this Harness's Mistral tokens and cost, and a mirror into the cost meter's quota card.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
